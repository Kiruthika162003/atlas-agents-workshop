# Copy to .env. Gemini runs on Vertex AI with your gcloud login:
#   gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Which model `adk web learn` uses. start.py sets this for the app itself.
#   gemini-3.8-flash                  Gemini on Google Cloud
#   ollama_chat/atlas-gemma     Gemma on this laptop (build it first, see README)
ATLAS_MODEL=gemini-3.8-flash
